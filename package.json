{
  "name": "infergo-viewer",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build:viewer": "tsc -p viewer/tsconfig.json && node viewer/build.mjs",
    "check:viewer": "tsc -p viewer/tsconfig.json && node viewer/build.mjs --check",
    "build:editor": "node internal/edit/web/fixtures/typed.mjs && tsc -p internal/edit/web/tsconfig.json && node internal/edit/web/build.mjs",
    "precheck:editor": "node internal/edit/web/fixtures/typed.mjs",
    "check:editor": "tsc -p internal/edit/web/tsconfig.json && node internal/edit/web/build.mjs --check && node internal/edit/web/build.mjs --test",
    "test:editor": "node internal/edit/web/fixtures/typed.mjs && node internal/edit/web/build.mjs --test",
    "dev:editor": "node internal/edit/web/fixtures/typed.mjs && node internal/edit/web/build.mjs --dev",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lint": "6.9.8",
    "@dagrejs/dagre": "3.1.3",
    "@playwright/test": "1.64.1",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
